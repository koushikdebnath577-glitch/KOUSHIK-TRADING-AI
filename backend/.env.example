# ==============================================================================
# KOUSHIK TRADING AI - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# IMPORTANT:
# 1. Never commit your actual .env file with real credentials to Git.
# 2. Add these environment variables in your Render Dashboard (Environment Settings).
# 3. For local testing, copy this file to .env and replace the placeholder values.
# ==============================================================================

# Server Port (Render sets process.env.PORT automatically)
PORT=3000

# Angel One SmartAPI Credentials (Obtain from https://smartapi.angelbroking.com)
ANGEL_API_KEY=YOUR_ANGEL_SMARTAPI_KEY_HERE
ANGEL_CLIENT_ID=YOUR_ANGEL_CLIENT_CODE_HERE
ANGEL_PIN=YOUR_ANGEL_4_DIGIT_PIN_HERE

# Angel One TOTP Secret (Base32 secret key from Angel One authenticator setup / QR code)
ANGEL_TOTP_SECRET=YOUR_ANGEL_TOTP_SECRET_KEY_HERE

# Client Telemetry & Device Binding (Required by Angel One SmartAPI security compliance)
ANGEL_PUBLIC_IP=106.193.147.98
ANGEL_LOCAL_IP=192.168.1.1
ANGEL_MAC_ADDRESS=fe80::216e:6507:4b90:3719

# Optional: CORS Allowed Origins (comma-separated, default is wildcard '*' for Android app access)
CORS_ORIGIN=*
